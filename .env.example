# Runtime: local | supabase
# Sem NEXT_PUBLIC_SUPABASE_URL o app usa o modo local automaticamente.
VETOR_RUNTIME=local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (obrigatório apenas no runtime supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Limites
VETOR_MAX_UPLOAD_BYTES=52428800
VETOR_MAX_MEGAPIXELS=100
VETOR_MAX_PDF_PAGES=30
VETOR_JOB_TIMEOUT_MS=180000
VETOR_MAX_ATTEMPTS=3
VETOR_SIGNED_URL_TTL_SECONDS=300
VETOR_RETENTION_DAYS=14
VETOR_DELETE_ORIGINALS=false

# Worker
VETOR_QUEUE_NAME=conversion_jobs
VETOR_VISIBILITY_TIMEOUT_SECONDS=180
VETOR_WORKER_CONCURRENCY=1

# Dados locais
VETOR_DATA_DIR=.data
